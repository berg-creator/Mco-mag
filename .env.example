# Скопируй в .env и заполни. Файл .env в git не попадает.
# На GitHub эти же имена заводятся в Settings → Secrets and variables → Actions.

# Anthropic: генератор текстов. Ключ — console.anthropic.com → API keys.
# Пополняется отдельно от подписки на Claude: нужен баланс на счёте API.
ANTHROPIC_API_KEY=

# Telegram: токен бота @Mcomagbot от @BotFather (/mybots → API Token).
TELEGRAM_BOT_TOKEN=

# Канал: @username канала или числовой id (-100…). Бот должен быть в нём
# администратором с правом публикации сообщений.
TELEGRAM_CHANNEL_ID=@mcomagazine

# Личные user id тех, кто ведёт канал, — сюда идут посты на утверждение.
# Нужны числа, не @username: узнать у @userinfobot. Если ведущих несколько,
# перечисли через запятую: превью придёт каждому, а кнопки примутся от любого.
# Каждый из них должен сам написать боту хоть раз — иначе Telegram не даст
# отправить ему сообщение первым.
TELEGRAM_ADMIN_ID=

# Куда публикует src.publish, когда флаг не задан: admin — себе в личку
# с кнопками, channel — сразу в канал. На GitHub то же самое живёт
# в Settings → Variables как PUBLISH_TARGET.
PUBLISH_TARGET=admin

# ВКонтакте — вторая фаза, пока можно оставить пустым.
# Токен сообщества с правами wall и photos: настройки сообщества → Работа с API.
VK_TOKEN=
VK_GROUP_ID=
